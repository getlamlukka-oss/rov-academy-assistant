{
  "name": "AutomationRun",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "description": "\u0e23\u0e2b\u0e31\u0e2a\u0e23\u0e2d\u0e1a\u0e01\u0e32\u0e23\u0e17\u0e33\u0e07\u0e32\u0e19 (UUID) \u0e43\u0e0a\u0e49\u0e1b\u0e49\u0e2d\u0e07\u0e01\u0e31\u0e19 duplicate \u0e41\u0e25\u0e30\u0e04\u0e33\u0e15\u0e2d\u0e1a\u0e40\u0e01\u0e48\u0e32\u0e17\u0e31\u0e1a\u0e02\u0e49\u0e2d\u0e43\u0e2b\u0e21\u0e48"
    },
    "state": {
      "type": "string",
      "enum": [
        "CREATING_SESSION",
        "WAITING_LOGIN",
        "LOGGED_IN",
        "READING_QUESTION",
        "MATCHING",
        "ANSWER_FOUND",
        "SELECTING",
        "NEXT_QUESTION",
        "NOT_FOUND",
        "COMPLETED",
        "ERROR",
        "STOPPED"
      ]
    },
    "last_fingerprint": {
      "type": "string",
      "description": "fingerprint \u0e02\u0e2d\u0e07\u0e04\u0e33\u0e16\u0e32\u0e21\u0e25\u0e48\u0e32\u0e2a\u0e38\u0e14\u0e17\u0e35\u0e48\u0e1b\u0e23\u0e30\u0e21\u0e27\u0e25\u0e1c\u0e25"
    },
    "matched_question_id": {
      "type": "string",
      "description": "Question ID \u0e17\u0e35\u0e48 match \u0e25\u0e48\u0e32\u0e2a\u0e38\u0e14"
    },
    "answered_count": {
      "type": "integer",
      "description": "\u0e08\u0e33\u0e19\u0e27\u0e19\u0e02\u0e49\u0e2d\u0e17\u0e35\u0e48\u0e15\u0e2d\u0e1a\u0e41\u0e25\u0e49\u0e27\u0e43\u0e19\u0e23\u0e2d\u0e1a\u0e19\u0e35\u0e49"
    },
    "last_result": {
      "type": "string",
      "description": "\u0e1c\u0e25\u0e25\u0e31\u0e1e\u0e18\u0e4c\u0e25\u0e48\u0e32\u0e2a\u0e38\u0e14 (\u0e2a\u0e23\u0e38\u0e1b\u0e2a\u0e31\u0e49\u0e19 \u0e44\u0e21\u0e48\u0e40\u0e01\u0e47\u0e1a\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e25\u0e31\u0e1a)"
    }
  },
  "required": [
    "run_id"
  ]
}