# สร้าง JWT_SECRET จริงด้วย python scripts/setup_env.py
DATABASE_URL=sqlite:///./rov.db
REDIS_URL=redis://localhost:6379/0
ACADEMY_BASE=https://academy.rov.in.th
ACADEMY_STORAGE=./data/academy_sessions
ACADEMY_MANUAL_LOGIN=true  # บังคับ manual login; ไม่เก็บ username/password Academy
HEADLESS=true
JWT_SECRET=change_me_to_random_long_string
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=1440
NEXT_PUBLIC_API=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ค่าเริ่มต้นเป็นตัวอย่าง ต้องตรวจ DOM ของ Academy ก่อนใช้จริง
SEL_LOGIN_BTN=button[type='submit']
SEL_USERNAME=input[name='username']
SEL_PASSWORD=input[name='password']
SEL_AUTHENTICATED=[data-academy-user]
SEL_QUESTION=[data-question]
SEL_OPTIONS=[data-option]
SEL_SUBMIT=button[data-submit]
SEL_NEXT=button[data-next]
SEL_COMPLETE=[data-complete]
ACADEMY_CHAPTER_PATH=/chapter/{chapter}/quiz
ACADEMY_LOGIN_PATH=/login
ACADEMY_LOGIN_TIMEOUT=300

ACADEMY_SESSION_LOCK_TTL=3700
ACADEMY_SESSION_LOCK_WAIT=2
